<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26FF2D6F">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#141419" />
                    <corners android:radius="3dp" />
                    <stroke android:width="1dp" android:color="#33333C" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <corners android:radius="3dp" />
                    <stroke android:width="1dp" android:color="#2A2A33" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
